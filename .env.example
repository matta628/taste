LASTFM_API_KEY=your_key_here
LASTFM_USERNAME=your_username_here
# No ANTHROPIC_API_KEY: Claude calls go through the host-side bridge
# (scripts/claude_bridge.py) under the subscription OAuth token in
# ~/.claude_token. See README "Claude bridge".
# Shared secret between the backend container and that bridge.
BRIDGE_TOKEN=generate_with_openssl_rand_base64_24
TELEGRAM_BOT_TOKEN=your_token_here
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=tastemaker/1.0
